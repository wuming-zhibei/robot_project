import random
from fastapi import FastAPI
from app.robot import robot
from app.model import MoveRequest,TaskRequest
app=FastAPI()


@app.get("/status")
def get_status():
    return robot.get_status()
@app.get("/sensor")
def get_sensor():
    return {
        "temperature":round(random.uniform(20,30),2),
        "humidity": round(random.uniform(40, 70), 2),
        "battery": random.randint(60, 100),
        "distance": round(random.uniform(10, 200), 2)
    }
@app.post("/move")
def move(request:MoveRequest):
    robot.move(request.direction,request.speed)
    return {
        "success": True,
        "message": "Robot is moving",
        "direction": request.direction,
        "speed": request.speed
    }
@app.post("/stop")
def stop():
    robot.stop()
    return{
        "success": True,
        "message": "Robot stopped"
    }
@app.post("/task")
def start_task(request:TaskRequest):
    allowed_tasks = [
        "forward",
        "backward",
        "left",
        "right",
        "square"
    ]
    if request.task not in allowed_tasks:
        return {
            "success": False,
            "message": "Unknown task",
            "task": request.task
        }
    robot.start_task(request.task)
    return {
        "success": True,
        "message": "Task started",
        "task": request.task
    }
